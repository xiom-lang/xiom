# ============================================================
# XIOM Project .gitignore
# ============================================================

# --- Rust (Phase 0 compiler implementation) ---
/target/
**/*.rs.bk
*.pdb

# --- R31: pinned stdlib checkout (scripts/fetch-stdlib.ps1|.sh) ---
# Post-split the stdlib lives in its own repo and is cloned here at the
# STDLIB_VERSION pin. Pre-split the in-tree stdlib/ is TRACKED (ignore rules
# do not affect tracked files); during the transition, NEW files under
# stdlib/ must be added with `git add -f` because this entry hides them.
stdlib/

# --- LLVM / Compiler artifacts ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.wasm
!xiom-playground/xiom_wasm_bg.wasm
*.wat
*.bc
*.ll

# Native binaries
*.exe
*.out

# --- IDE / Editor ---
.vscode/
.VSCodeCounter/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Build output ---
/build/
/dist/
/out/

# --- Package manager ---
/xiom-packages/

# --- Test artifacts ---
*.snap.new
*.xiom_ai
*.smt2
*.ilk
a.exe
test_*.exe
e2e_*.exe
selfhost_*.exe
diff_*.exe
output.exe
demo.wasm
xiomc.wasm
!new_xiomc.exe

# --- Environment / Config ---
.env
.env.local
.env.*.local

# --- OS files ---
Desktop.ini
$RECYCLE.BIN/

# --- Logs ---
*.log

# --- Temporary ---
/tmp/
/temp/
*.tmp

release/

# --- Tooling / AI state (generated) ---
.xiom_ai.json
.xiom_ai_cache/
# AI config may contain a plaintext API key -- never commit it.
.xiom_ai_config.json
.xiom_ai_config
xiom_verify_output.smt2

# --- Alternate build targets ---
/target2/

# --- Test artifacts (generated by e2e/stdlib/probe harnesses) ---
# `*.exe` and `*.ll` above already cover compiled/IR outputs; these entries
# cover harness temp sources and per-suite scratch dirs.
.test_build/
.testlogs/
*.exe.ll
e2e_*_test.exe
*_test.exe
e2e_*_test*.exe
stdlib_smoke_test.exe
a.exe.ll
_e2e_*.xi
e2e_*.xi
xiom.code-workspace
kilo.jsonc
