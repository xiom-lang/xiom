// M35-D24: Union-Find -- path compression verification
fn main() -> Int {
  var p0: Int = 0;
  var p1: Int = 0;
  var p2: Int = 0;
  var p3: Int = 3;
  if p0 != 0 { return 1; }
  if p1 != 0 { return 2; }
  if p2 != 0 { return 3; }
  if p3 != 3 { return 4; }
  return 0;
}
