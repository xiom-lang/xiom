// M35-D16: Trie -- prefix patterns represented as integer sequences
fn main() -> Int {
  var n: Int = 0;
  var child_a: Int = 1;
  var child_b: Int = 2;
  var is_end: Bool = true;
  if n != 0 { return 1; }
  if child_a != 1 { return 2; }
  if child_b != 2 { return 3; }
  if is_end == false { return 4; }
  return 0;
}
