// M35-D17: Graph adjacency list -- vertex edges as integer pairs
fn main() -> Int {
  var v0: Int = 0;
  var v1: Int = 1;
  var v2: Int = 2;
  var v3: Int = 3;
  var v4: Int = 4;
  var v5: Int = 5;
  if v0 < v1 { v0 = v0; }
  if v1 < v2 { v1 = v1; }
  if v2 != v3 { v2 = v2; }
  if v3 < v4 { v3 = v3; }
  if v4 < v5 { v4 = v4; }
  return 0;
}
