// M33-A07: Array of Str -- creation and string comparison
fn main() -> Int {
  var arr = ["alpha", "beta", "gamma"];
  if arr[0] == "alpha" && arr[1] == "beta" && arr[2] == "gamma" { return 0; }
  return 1;
}
