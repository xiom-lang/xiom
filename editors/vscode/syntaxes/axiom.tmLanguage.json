{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AXIOM",
  "scopeName": "source.axiom",
  "fileTypes": ["ax"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#contracts" },
    { "include": "#derive" },
    { "include": "#keywords" },
    { "include": "#method-decl" },
    { "include": "#types" },
    { "include": "#generics" },
    { "include": "#borrows" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.axiom",
          "match": "//.*$"
        },
        {
          "name": "comment.block.axiom",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.axiom",
          "match": "\\b(requires|ensures|invariant)\\b\\s*:"
        }
      ]
    },

    "derive": {
      "patterns": [
        {
          "match": "\\b(derive)\\s*(\\[)",
          "captures": {
            "1": { "name": "keyword.other.derive.axiom" },
            "2": { "name": "punctuation.bracket.axiom" }
          }
        },
        {
          "name": "entity.name.type.derive.axiom",
          "match": "\\b(Eq|Clone|Display|Hash|Ord)\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.axiom",
          "match": "\\b(if|else|match|for|while|loop|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.axiom",
          "match": "\\b(fn|let|type|enum|use|module|const|mut|pub|async|await|spawn|comptime|extern|impl)\\b"
        },
        {
          "name": "keyword.other.axiom",
          "match": "\\b(self|Self)\\b"
        },
        {
          "name": "constant.language.axiom",
          "match": "\\b(true|false|None|Some|Ok|Err|result)\\b"
        }
      ]
    },

    "method-decl": {
      "patterns": [
        {
          "comment": "TypeName.methodName receiver-style declaration, e.g. fn Vec3.dot(...)",
          "match": "\\b(fn)\\s+([A-Z][A-Za-z0-9_]*)\\s*(\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.axiom" },
            "2": { "name": "entity.name.type.axiom" },
            "3": { "name": "punctuation.accessor.axiom" },
            "4": { "name": "entity.name.function.axiom" }
          }
        },
        {
          "comment": "plain function declaration",
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.axiom" },
            "2": { "name": "entity.name.function.axiom" }
          }
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.axiom",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|Float32|Float64|Bool|Str|Char|UInt|UInt8|UInt16|UInt32|UInt64|Vec|Map|Set|Slice|Option|Result|Stack)\\b"
        },
        {
          "name": "entity.name.type.axiom",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "generics": {
      "patterns": [
        {
          "comment": "inline type constraint, e.g. [T: Ord] or [T: Eq + Hash]",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": { "0": { "name": "punctuation.bracket.axiom" } },
          "endCaptures": { "0": { "name": "punctuation.bracket.axiom" } },
          "patterns": [
            {
              "name": "variable.parameter.type.axiom",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "keyword.operator.constraint.axiom",
              "match": ":|\\+"
            }
          ]
        }
      ]
    },

    "borrows": {
      "patterns": [
        {
          "name": "keyword.operator.borrow.axiom",
          "match": "&mut\\b|&"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.axiom",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.axiom",
          "match": "\\\\."
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.axiom",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.axiom",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.axiom",
          "match": "->|\\?"
        },
        {
          "name": "keyword.operator.comparison.axiom",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.axiom",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.axiom",
          "match": "\\+|\\-|\\*|/|%"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "function call",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.axiom"
        }
      ]
    }
  }
}
