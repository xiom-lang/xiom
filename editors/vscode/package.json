{
  "name": "axiom",
  "displayName": "AXIOM Language Support",
  "description": "Syntax highlighting, autocomplete, go-to-definition, and diagnostics for the AXIOM programming language.",
  "version": "0.10.0",
  "publisher": "axiom-lang",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:axiom"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "axiom",
      "aliases": ["AXIOM", "axiom"],
      "extensions": [".ax"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "axiom",
      "scopeName": "source.axiom",
      "path": "./syntaxes/axiom.tmLanguage.json"
    }],
    "configuration": {
      "title": "AXIOM",
      "properties": {
        "axiom.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the axiom-lsp binary. Leave empty to use bundled binary."
        }
      }
    }
  }
}
