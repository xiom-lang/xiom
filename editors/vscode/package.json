{
  "name": "xiom",
  "displayName": "XIOM Language Support",
  "description": "Syntax highlighting, autocomplete, go-to-definition, and diagnostics for the XIOM programming language.",
  "version": "0.10.0",
  "publisher": "xiom-lang",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:xiom"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "xiom",
      "aliases": ["XIOM", "xiom"],
      "extensions": [".xi"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "xiom",
      "scopeName": "source.xiom",
      "path": "./syntaxes/xiom.tmLanguage.json"
    }],
    "configuration": {
      "title": "XIOM",
      "properties": {
        "xiom.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the xiom-lsp binary. Leave empty to use bundled binary."
        }
      }
    }
  }
}
