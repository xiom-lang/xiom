{
  "name": "xiom",
  "displayName": "XIOM Toolchain",
  "description": "Syntax highlighting, autocomplete, go-to-definition, diagnostics, and debugging for the XIOM programming language.",
  "version": "0.12.0",
  "publisher": "xiom-lang",
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://xiom-lang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiom-lang/xiom"
  },
  "bugs": {
    "url": "https://github.com/xiom-lang/xiom/issues"
  },
  "keywords": [
    "xiom",
    "language",
    "compiler",
    "debugger",
    "debug adapter",
    "lsp",
    "systems programming",
    "native"
  ],
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Debuggers"],
  "activationEvents": [
    "onLanguage:xiom",
    "onDebugInitialConfigurations",
    "onDebugResolve:xiom"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "xiom",
      "aliases": ["XIOM", "xiom"],
      "extensions": [".xi"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "xiom",
      "scopeName": "source.xiom",
      "path": "./syntaxes/xiom.tmLanguage.json"
    }],
    "debuggers": [{
      "type": "xiom",
      "label": "XIOM Debugger",
      "configurationAttributes": {
        "launch": {
          "properties": {
            "program": {
              "type": "string",
              "description": "Path to the compiled XIOM executable (e.g., a.exe or target/debug/myapp.exe).",
              "default": "${workspaceFolder}/a.exe"
            },
            "args": {
              "type": "array",
              "description": "Command-line arguments passed to the XIOM program.",
              "default": []
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for the XIOM program.",
              "default": "${workspaceFolder}"
            },
            "stopOnEntry": {
              "type": "boolean",
              "description": "Stop at program entry point (main function).",
              "default": true
            },
            "contractTraps": {
              "type": "boolean",
              "description": "Break on contract violation traps (resolves contract name from DWARF).",
              "default": true
            }
          }
        }
      },
      "initialConfigurations": [
        {
          "type": "xiom",
          "request": "launch",
          "name": "Debug XIOM Program",
          "program": "${workspaceFolder}/a.exe",
          "stopOnEntry": true
        }
      ],
      "configurationSnippets": [
        {
          "label": "XIOM: Launch",
          "description": "Launch and debug a compiled XIOM program",
          "body": {
            "type": "xiom",
            "request": "launch",
            "name": "Debug XIOM Program",
            "program": "^\"\\${workspaceFolder}/a.exe\"",
            "stopOnEntry": true
          }
        }
      ]
    }],
    "configuration": {
      "title": "XIOM",
      "properties": {
        "xiom.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the xiom-lsp binary. Leave empty to resolve xiom-lsp from PATH (the toolchain installer puts bin/ on PATH) or from a workspace target/ build."
        },
        "xiom.debugAdapterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the xiom-dbg debug adapter. Leave empty to resolve xiom-dbg from PATH (the toolchain installer puts bin/ on PATH) or from a workspace target/ build."
        },
        "xiom.dbg.path": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Use xiom.debugAdapterPath instead.",
          "description": "Deprecated alias for xiom.debugAdapterPath."
        }
      }
    },
    "commands": [
      {
        "command": "xiom.recheckToolchain",
        "title": "Recheck toolchain",
        "category": "XIOM"
      }
    ]
  }
}
