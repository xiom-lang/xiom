fn axiom_char_at(src: Int, pos: Int) -> Int;

fn main() -> Int {
  var src = 12345;
  var pos = 0;
  var len = 100;
  var count = 0;
  while pos < len {
    var c = axiom_char_at(&src, &pos);
    if c == 95 {
      pos = pos + 2;
      var done = 1 == 0;
      count = count + 1;
    } elif c == 50 {
      count = count + 1;
    } else {
      pos = pos + 1;
    }
  }
  return 0;
}
