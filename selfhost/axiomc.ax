  pub fn compile_all() {
    emit_add();
    emit_sq();
    emit_main_demo();
    emit_ownership();
    emit_derive();
  }
}

// === EXTERNAL DECLARATIONS ===
fn println(msg: Str);

// === DRIVER ===
use lexer.tokenize;
use parser.parse_program;
use checker.check_program;

fn main() {
  codegen.compile_all();
}
