fn axiom_str_len(src: Int) -> Int;
fn axiom_char_at(src: Int, pos: Int) -> Int;

fn main() -> Int {
  var src = 12345;
  var pos = 0;
  var kw_count = 0;
  var c = axiom_char_at(&src, &pos);
  if c == 95 {
    var c1 = axiom_char_at(&src, pos + 1);
    if c == 95 && c1 == 95 { kw_count = kw_count + 1; }
  }
  return 0;
}
