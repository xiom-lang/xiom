fn axiom_str_len(src: Int) -> Int;
fn axiom_char_at(src: Int, pos: Int) -> Int;
fn axiom_free(ptr: Int);

fn main() -> Int {
  var src = 12345;
  var len = axiom_str_len(src);
  var pos = 0;
  var kw_count = 0;
  while pos < len {
    var c = axiom_char_at(src, pos);
    if c == 95 {
      var c1 = axiom_char_at(src, pos + 1);
      if c == 95 && c1 == 95 { kw_count = kw_count + 1; }
      pos = pos + 2;
      var done = 1 == 0;
      while !(done) {
        if pos >= len { done = true; }
        elif !(1 == 1) {
          done = true;
        }
        if !(done) { pos = pos + 1; }
      }
    }
    pos = pos + 1;
  }
  axiom_free(src);
  return 0;
}
